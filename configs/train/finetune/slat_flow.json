{
    "models": {
        "denoiser": {
            "name": "ElasticSLatFlowModel",
            "args": {
                "resolution": 64,
                "in_channels": 32,
                "out_channels": 32,
                "model_channels": 1536,
                "cond_channels": 1024,
                "num_blocks": 30,
                "num_heads": 12,
                "mlp_ratio": 5.3334,
                "pe_mode": "rope",
                "share_mod": true,
                "initialization": "scaled",
                "qk_rms_norm": true,
                "qk_rms_norm_cross": true
            }
        }
    },
    "dataset": {
        "name": "ImageConditionedSLatShape3DFront",
        "args": {
            "resolution": 1024,
            "image_size": 1024,
            "min_aesthetic_score": null,
            "max_tokens": 32768,
            "render_root": {
                "InstPIFu_3D_FRONT": "datasets/InstPIFu-3D-FRONT/Train/raw/renders",
                "MIDI_3D_FRONT": "datasets/MIDI-3D-FRONT/Train/raw/3D-FRONT-RENDER"
            },
            "strict_cond_image": true,
            "skip_first_frame": {
                "MIDI_3D_FRONT": true
            },
            "dataset_repeat": {
                "MIDI_3D_FRONT": 2
            },
            "normalization": {
                "mean": [
                    0.781296,
