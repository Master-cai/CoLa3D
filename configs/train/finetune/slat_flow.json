                    5.405691
                ]
            },
            "pretrained_slat_dec": "pretrained_ckpts/ckpts/shape_dec_next_dc_f16c32_fp16"
        }
    },
    "trainer": {
        "name": "ImageConditionedSparseFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 30000,
            "dataloader_workers": 4,
            "batch_size_per_gpu": 8,
            "batch_split": 4,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-05,
                    "weight_decay": 0.01,
                    "betas": [
                        0.9,
                        0.95
                    ],
                    "eps": 1e-08
                }
            },
            "lr_scheduler": {
                "name": "CosineWarmupLRScheduler",
                "args": {
                    "warmup_steps": 500,
                    "min_lr_ratio": 0.01
                }
            },
            "ema_rate": [
                0.9999
            ],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "elastic": {
                "name": "LinearMemoryController",
                "args": {
                    "target_ratio": 0.75,
                    "max_mem_ratio_start": 0.25
                }
            },
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "finetune_ckpt": {
                "denoiser": "pretrained_ckpts/ckpts/slat_flow_img2shape_dit_1_3B_1024_bf16.safetensors"
            },
            "i_log": 50,
            "i_sample": 1000,
            "i_save": 1000,
            "snapshot_num_samples": 1,
            "snapshot_batch_size": 1,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "uniform",
                "args": {}
            },
            "sigma_min": 1e-05,
            "image_cond_model": {
                "name": "DinoV3FeatureExtractor",
                "args": {
                    "model_name": "facebook/dinov3-vitl16-pretrain-lvd1689m",
                    "image_size": 1024
                }
            }
        }
    },
    "data_dir": {
        "InstPIFu_3D_FRONT": {
            "base": "datasets/InstPIFu-3D-FRONT/Train",
            "shape_latent": "datasets/InstPIFu-3D-FRONT/Train/shape_latents/shape_enc_next_dc_f16c32_fp16_1024"
        },
        "MIDI_3D_FRONT": {
            "base": "datasets/MIDI-3D-FRONT/Train",
            "shape_latent": "datasets/MIDI-3D-FRONT/Train/shape_latents/shape_enc_next_dc_f16c32_fp16_1024"
        }
    }
