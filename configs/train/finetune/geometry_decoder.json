{
    "models": {
        "decoder": {
            "name": "FlexiDualGridVaeDecoder",
            "args": {
                "resolution": 512,
                "model_channels": [
                    1024,
                    512,
                    256,
                    128,
                    64
                ],
                "latent_channels": 32,
                "num_blocks": [
                    4,
                    16,
                    8,
                    4,
                    0
                ],
                "block_type": [
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d"
                ],
                "up_block_type": [
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d"
                ],
                "block_args": [
                    {
                        "use_checkpoint": false
                    },
                    {
                        "use_checkpoint": false
                    },
                    {
                        "use_checkpoint": false
                    },
                    {
                        "use_checkpoint": false
                    },
                    {
                        "use_checkpoint": false
                    }
                ],
                "use_dtype": "bf16"
            }
        }
    },
    "dataset": {
        "name": "FlexiDualGridMultiObjDataset",
        "args": {
            "resolution": 512,
            "max_active_voxels": 1500000,
            "max_num_faces": 1000000,
            "min_aesthetic_score": null,
            "max_objects": 8,
            "render_root": {
                "InstPIFu_3D_FRONT": "datasets/InstPIFu-3D-FRONT/Train/raw/renders",
                "MIDI_3D_FRONT": "datasets/MIDI-3D-FRONT/Train/raw/3D-FRONT-RENDER"
            },
            "image_size": 512,
            "skip_mesh": false,
            "skip_per_obj": false,
            "preload_mode": null,
            "shape_latent_root": {
                "InstPIFu_3D_FRONT": "datasets/InstPIFu-3D-FRONT/Train/shape_latents/shape_enc_next_dc_f16c32_fp16_512",
                "MIDI_3D_FRONT": "datasets/MIDI-3D-FRONT/Train/shape_latents/shape_enc_next_dc_f16c32_fp16_512"
            },
            "skip_first_frame": {
                "MIDI_3D_FRONT": true
            },
            "dataset_repeat": {
                "MIDI_3D_FRONT": 2
            }
        }
    },
    "trainer": {
        "name": "SceneDecoderFinetuneTrainer",
        "args": {
            "max_parts": 8,
            "dataloader_workers": 4,
            "max_steps": 40000,
            "batch_size_per_gpu": 6,
            "batch_split": 2,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-05,
                    "weight_decay": 0.0
                }
            },
            "lr_scheduler": {
                "name": "CosineWarmupLRScheduler",
                "args": {
                    "warmup_steps": 500,
                    "min_lr_ratio": 0.01
                }
            },
            "ema_rate": [
                0.9999
            ],
            "mix_precision_mode": "inflat_all",
            "mix_precision_dtype": "bfloat16",
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "finetune_ckpt": {
                "decoder": "pretrained_ckpts/ckpts/shape_dec_next_dc_f16c32_fp16.safetensors"
            },
            "snapshot_num_samples": 1,
            "snapshot_batch_size": 1,
            "i_log": 50,
            "i_sample": 1000,
            "i_save": 2000,
            "lambda_subdiv": 0.1,
            "lambda_intersected": 0.1,
            "lambda_vertice": 0.01,
            "lambda_mask": 1,
            "lambda_depth": 10,
            "lambda_normal": 1,
            "lambda_kl": 1e-06,
            "lambda_ssim": 0.2,
            "lambda_lpips": 0.2,
            "render_resolution": 512,
            "camera_randomization_config": {
                "radius_range": [
                    2,
                    100
                ]
            }
        }
    },
    "data_dir": {
        "InstPIFu_3D_FRONT": {
            "base": "datasets/InstPIFu-3D-FRONT/Train",
            "mesh_dump": "datasets/InstPIFu-3D-FRONT/Train/mesh_dumps",
            "dual_grid": "datasets/InstPIFu-3D-FRONT/Train/dual_grid_512"
        },
        "MIDI_3D_FRONT": {
            "base": "datasets/MIDI-3D-FRONT/Train",
            "mesh_dump": "datasets/MIDI-3D-FRONT/Train/mesh_dumps",
            "dual_grid": "datasets/MIDI-3D-FRONT/Train/dual_grid_512"
        }
    }
}
