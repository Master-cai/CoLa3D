{
    "models": {
        "denoiser": {
            "name": "SparseStructureFlowModel",
            "args": {
                "resolution": 16,
                "in_channels": 8,
                "out_channels": 8,
                "model_channels": 1536,
                "cond_channels": 1024,
                "num_blocks": 30,
                "num_heads": 12,
                "mlp_ratio": 5.3334,
                "pe_mode": "rope",
                "share_mod": true,
                "initialization": "scaled",
                "qk_rms_norm": true,
                "qk_rms_norm_cross": true
            }
        }
    },
    "dataset": {
        "name": "ImageConditionedSparseStructureLatent3DFront",
        "args": {
            "min_aesthetic_score": null,
            "image_size": 512,
            "strict_cond_image": true,
            "render_root": {
                "InstPIFu_3D_FRONT": "datasets/InstPIFu-3D-FRONT/Train/raw/renders",
                "MIDI_3D_FRONT": "datasets/MIDI-3D-FRONT/Train/raw/3D-FRONT-RENDER"
            },
            "pretrained_ss_dec": "microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16",
            "skip_first_frame": {
                "MIDI_3D_FRONT": true
            },
            "dataset_repeat": {
                "InstPIFu_3D_FRONT": 2,
                "MIDI_3D_FRONT": 2
            }
        }
    },
    "trainer": {
        "name": "ImageConditionedFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 40000,
            "batch_size_per_gpu": 12,
            "batch_split": 4,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-05,
                    "weight_decay": 0.01,
                    "betas": [
                        0.9,
                        0.95
                    ],
                    "eps": 1e-08
                }
            },
            "lr_scheduler": {
                "name": "CosineWarmupLRScheduler",
                "args": {
                    "warmup_steps": 1000,
                    "min_lr_ratio": 0.01
                }
            },
            "ema_rate": [
                0.9999
            ],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "finetune_ckpt": {
                "denoiser": "pretrained_ckpts/ckpts/ss_flow_img_dit_1_3B_64_bf16.safetensors"
            },
            "i_log": 50,
            "i_sample": 500,
            "i_save": 1000,
            "snapshot_num_samples": 1,
            "snapshot_batch_size": 1,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 1.0,
                    "std": 1.0
                }
            },
            "sigma_min": 1e-05,
            "image_cond_model": {
                "name": "DinoV3FeatureExtractor",
                "args": {
                    "model_name": "facebook/dinov3-vitl16-pretrain-lvd1689m",
                    "image_size": 512
                }
            }
        }
    },
    "data_dir": {
        "InstPIFu_3D_FRONT": {
            "base": "datasets/InstPIFu-3D-FRONT/Train",
            "ss_latent": "datasets/InstPIFu-3D-FRONT/Train/ss_latents/ss_enc_conv3d_16l8_fp16_64"
        },
        "MIDI_3D_FRONT": {
            "base": "datasets/MIDI-3D-FRONT/Train",
            "ss_latent": "datasets/MIDI-3D-FRONT/Train/ss_latents/ss_enc_conv3d_16l8_fp16_64"
        }
    }
}
